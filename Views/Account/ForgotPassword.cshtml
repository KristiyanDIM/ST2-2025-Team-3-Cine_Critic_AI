@{
    ViewData["Title"] = "Забравена парола";
}

<div class="forgot-password-container">
    <div class="forgot-card shadow-lg">
        <h2 class="text-center mb-4 text-primary fw-bold">🔑 Забравена парола</h2>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">Имейл адрес</label>
                <input type="email" id="email" name="email" class="form-control form-control-lg"
                       required placeholder="✉️ Въведете своя имейл" />
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-semibold">
                Продължи
            </button>
        </form>

        <div class="text-center mt-4">
            <a asp-action="Login" class="back-link">
                ⬅️ Назад към вход
            </a>
        </div>
    </div>
</div>

<style>
    /* Центриране на контейнера */
    .forgot-password-container {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Карта с формата */
    .forgot-card {
        background: #fff;
        border-radius: 16px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 450px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .forgot-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

    /* Полета и бутони */
    .form-label {
        color: #333;
        font-size: 1rem;
    }

    .form-control {
        border-radius: 10px;
        padding: 0.75rem 1rem;
        border: 1px solid #ccc;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

        .form-control:focus {
            border-color: #4a90e2;
            box-shadow: 0 0 5px rgba(74, 144, 226, 0.4);
        }

    .btn-primary {
        background-color: #4a90e2;
        border: none;
        border-radius: 10px;
        padding: 0.75rem;
        font-size: 1.1rem;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-primary:hover {
            background-color: #357ab8;
            transform: translateY(-2px);
        }

    /*Линк назад */
    .back-link {
        text-decoration: none;
        color: #4a90e2;
        font-weight: 500;
        transition: color 0.2s;
    }

        .back-link:hover {
            color: #2e6fb8;
            text-decoration: underline;
        }
</style>
