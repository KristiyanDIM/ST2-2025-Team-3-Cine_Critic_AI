@model Cine_Critic_AI.Models.LoginViewModel
<head>
    <link rel="stylesheet" href="~/css/Account/AccountLoginCSS.css" asp-append-version="true" />
</head>

@{
    ViewData["Title"] = "Вход";
}
<body>
<div class="login-page">
    <div class="login-card shadow-lg">
        <div class="text-center mb-4">
            <div class="login-icon">🎬</div>
            <h2 class="fw-bold">Добре дошъл отново!</h2>
            <p class="text-muted">Влез в профила си, за да продължиш</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold">Потребителско име</label>
                <input asp-for="Username" class="form-control form-control-lg" placeholder="Въведете потребителско име" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-2">
                <label asp-for="Password" class="form-label fw-semibold">Парола</label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Въведете парола" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- 🔹 Линк за забравена парола -->
            <div class="text-end mb-4">
                <a asp-action="ForgotPassword" class="text-decoration-none small text-primary">
                    Забравена парола?
                </a>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">🔐 Вход</button>
        </form>

        <div class="text-center mt-3">
            <p>Нямаш акаунт? <a asp-action="Register" class="register-link">Регистрация</a></p>
        </div>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</body>