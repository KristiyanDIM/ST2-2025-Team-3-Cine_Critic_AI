@{
    ViewData["Title"] = "Смяна на парола";
}

<div class="reset-password-container">
    <div class="reset-card shadow-lg">
        <h2 class="text-center mb-4 text-primary fw-bold">🔒 Смяна на парола</h2>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="username" class="form-label fw-semibold">👤 Потребителско име</label>
                <input type="text" id="username" name="username" class="form-control form-control-lg"
                       required placeholder="Въведете потребителско име" />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label fw-semibold">✉️ Имейл</label>
                <input type="email" id="email" name="email" class="form-control form-control-lg"
                       required value="@ViewBag.Email" placeholder="Въведете вашия имейл" />
            </div>

            <div class="mb-4">
                <label for="newPassword" class="form-label fw-semibold">🔑 Нова парола</label>
                <input type="password" id="newPassword" name="newPassword"
                       class="form-control form-control-lg" required placeholder="Въведете новата парола" />
            </div>

            <button type="submit" class="btn btn-success w-100 fw-semibold">
                ✅ Смени паролата
            </button>
        </form>

        <div class="text-center mt-4">
            <a asp-action="Login" class="back-link">⬅️ Назад към вход</a>
        </div>
    </div>
</div>

<style>
    /* Центриране на формата */
    .reset-password-container {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #f0f6ff, #f9fcff);
    }

    /*Карта */
    .reset-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 2.5rem 2rem;
        width: 100%;
        max-width: 480px;
        transition: all 0.3s ease;
    }

        .reset-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

    /* Полета */
    .form-label {
        color: #333;
        font-size: 1rem;
    }

    .form-control {
        border-radius: 10px;
        padding: 0.8rem 1rem;
        border: 1px solid #ccc;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus {
            border-color: #4a90e2;
            box-shadow: 0 0 6px rgba(74, 144, 226, 0.4);
        }

    /* Бутон */
    .btn-success {
        background-color: #4a90e2;
        border: none;
        border-radius: 10px;
        padding: 0.8rem;
        font-size: 1.1rem;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-success:hover {
            background-color: #357ab8;
            transform: translateY(-2px);
        }

    /*Линк назад */
    .back-link {
        text-decoration: none;
        color: #4a90e2;
        font-weight: 500;
        transition: color 0.2s ease;
    }

        .back-link:hover {
            color: #2e6fb8;
            text-decoration: underline;
        }

    @@media (max-width: 576px) {
        .reset-card

    {
        padding: 2rem 1.5rem;
        border-radius: 14px;
    }

    .btn-success {
        font-size: 1rem;
    }

    }
</style>
