@model Cine_Critic_AI.Models.Movie

<head>
    <link rel="stylesheet" href="~/css/Movies/MoviesCreateCSS.css" asp-append-version="true" />
</head>

@{
    ViewData["Title"] = "Добави нов филм";
}

<body>
<div class="container mt-5">
    <div class="form-card mx-auto p-4">
        <h2 class="text-center mb-4">🎬 Добави нов филм</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="All" class="text-danger text-center mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Заглавие</label>
                <input asp-for="Title" class="form-control" placeholder="Въведете заглавие" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="form-label fw-semibold">Снимка (URL)</label>
                <input asp-for="ImageUrl" class="form-control" placeholder="Въведете URL на изображение (по избор)" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Year" class="form-label fw-semibold">Година</label>
                <input asp-for="Year" class="form-control" placeholder="Въведете година" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Genre" class="form-label fw-semibold">Жанр</label>
                <input asp-for="Genre" class="form-control" placeholder="Въведете жанр" />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Director" class="form-label fw-semibold">Режисьор</label>
                <input asp-for="Director" class="form-control" placeholder="Въведете режисьор" />
                <span asp-validation-for="Director" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Description" class="form-label fw-semibold">Описание</label>
                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Добавете описание (по избор)"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="AddedOn" class="form-label"></label>
                <input asp-for="AddedOn" class="form-control" />
            </div>


            <div class="text-center">
                <button type="submit" class="btn btn-success btn-lg px-4 me-2">
                    💾 Запази
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                    ⬅️ Назад
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

</body>