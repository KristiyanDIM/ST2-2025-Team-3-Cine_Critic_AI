@model IEnumerable<Cine_Critic_AI.Models.Review>

@{
    ViewData["Title"] = "Ревюта";
    var selectedRate = ViewData["SelectedRate"] as int?;
    var selectedMovieId = ViewData["SelectedMovieId"] as int?;
    var movies = ViewData["Movies"] as List<Cine_Critic_AI.Models.Movie>;
}

<h2 class="text-center my-4 fw-bold text-primary">@ViewData["Title"]</h2>

<!-- 🎨 Филтърна лента -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 filter-bar">
    <!-- Ляво: бутон за добавяне -->
    <div>
        <a asp-action="Create" class="btn btn-success shadow-sm px-4">
            ➕ Добави ново ревю
        </a>
    </div>

    <!-- Дясно: филтри -->
    <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-3 justify-content-end filter-form">
        <div class="d-flex flex-column">
            <select id="rate" name="rate" class="form-select">
                <option value="">Оценка</option>
                @for (int r = 1; r <= 5; r++)
                {
                    <option value="@r" @@(selectedRate == r ? "selected" : "")>@r</option>
                }
            </select>
        </div>

        <div class="d-flex flex-column">
            <select id="movieId" name="movieId" class="form-select">
                <option value="">Всички филми</option>
                @foreach (var movie in movies)
                {
                    <option value="@movie.Id" @@(selectedMovieId == movie.Id ? "selected" : "")>@movie.Title</option>
                }
            </select>
        </div>

        <div class="d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary">Филтрирай</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
        </div>
    </form>
</div>

<!-- 🎬 Галерия с ревюта (остава както беше) -->
<div class="reviews-gallery">
    @if (!Model.Any())
    {
        <p class="text-center text-muted">Няма намерени ревюта по зададените критерии.</p>
    }
    else
    {
        @foreach (var review in Model)
        {
            <div class="review-card">
                <div class="poster">
                    <img src="@(!string.IsNullOrEmpty(review.Movie?.ImageUrl) ? review.Movie.ImageUrl : "/images/default_poster.jpg")"
                         alt="@review.Movie?.Title" />
                </div>

                <div class="review-info">
                    <h4>@review.Movie?.Title</h4>
                    <div class="rating-emotion">
                        <span class="rating">⭐ @review.Rate/5</span>
                    </div>
                    <p class="comment">@(!string.IsNullOrEmpty(review.Comment) ? review.Comment : "Няма коментар")</p>

                    <div class="buttons">
                        <a asp-action="Details" asp-route-id="@review.Id" class="btn btn-sm btn-primary">Детайли</a>
                        <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-warning">Редактирай</a>
                        <a asp-action="Delete" asp-route-id="@review.Id" class="btn btn-sm btn-danger">Изтрий</a>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .filter-bar {
        background: #f8f9fa;
        padding: 1rem 1.5rem;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        justify-self: center;
        width:80%;
    }

    .filter-form select {
        min-width: 150px;
    }

    .filter-form label {
        color: #333;
        font-size: 0.9rem;
    }

    .filter-form button, .filter-form a.btn {
        font-weight: 600;
    }

    .btn-success {
        background-color: #4a90e2;
        border: none;
    }

    .btn-success:hover {
        background-color: #357ab8;
    }

    .btn-outline-secondary:hover {
        background-color: #e9ecef;
    }
</style>
