@model Cine_Critic_AI.Models.Review
<head>
    <link rel="stylesheet" href="~/css/Reviews/ReviewsEditCSS.css" asp-append-version="true" />
</head>
@{
    ViewData["Title"] = "Редактирай ревю";
}

<body>
<div class="container mt-5 d-flex justify-content-center">
    <div class="edit-review-card p-4 shadow-lg rounded-4">
        <div class="text-center mb-4">
            <span class="edit-icon">✏️</span>
            <h2 class="fw-bold">@ViewData["Title"]</h2>
            <p class="text-muted">Промени информацията за ревюто по-долу</p>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Rate" class="form-label fw-semibold">Оценка</label>
                <input asp-for="Rate" class="form-control" placeholder="Въведете оценка (1-5)" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Comment" class="form-label fw-semibold">Коментар</label>
                <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Променете вашия коментар"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EmotionTone" class="form-label fw-semibold">Емоционален тон</label>
                <input asp-for="EmotionTone" class="form-control" placeholder="например: позитивен, неутрален, негативен" />
                <span asp-validation-for="EmotionTone" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Date" class="form-label fw-semibold">Дата</label>
                <input asp-for="Date" type="date" class="form-control" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 fw-semibold">⬅️ Назад</a>
                <button type="submit" class="btn btn-success px-4 py-2 fw-semibold">💾 Запази промените</button>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
</body>